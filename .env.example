# ==============================================================================
# CẤU HÌNH MẪU CHO MÔI TRƯỜNG PHÁT TRIỂN CỤC BỘ - VADIRAS FLOW
# Chỉ chứa giá trị giữ chỗ. Tuyệt đối KHÔNG điền khóa thật rồi đưa lên Git.
# ==============================================================================

# --- Cấu hình ứng dụng web FastAPI ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEMO_MODE=true
# Danh sách địa chỉ giao diện web được phép gọi API (phân cách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Kết nối cơ sở dữ liệu PostgreSQL + pgvector ---
# Khi chạy bằng Docker Compose, tên máy chủ là postgres
DATABASE_URL=postgresql+asyncpg://vadiras:thay_mat_khau_cuc_bo@postgres:5432/vadiras_flow

# --- Máy chủ điều phối quy trình Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=vadiras-flow-main

# --- Bảo mật thẻ đăng nhập JWT (hãy thay chuỗi ngẫu nhiên dài ít nhất 32 ký tự trong .env) ---
JWT_SECRET_KEY=thay_chuoi_bi_mat_jwt_ngau_nhien_it_nhat_32_ky_tu
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=vadiras-flow
JWT_AUDIENCE=vadiras-flow-api

# --- Cấu hình nhà cung cấp AI (mặc định dùng bộ giả lập mock, không cần khóa API) ---
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=mock-default
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Cấu hình kết nối GitHub App (mặc định dùng bộ giả lập mock) ---
GITHUB_CONNECTOR_MODE=mock
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=thay_chuoi_bi_mat_webhook_tai_day
GITHUB_ALLOWED_REPOS=Duckyeeen/VADIRAS-FLOW
NOTIFICATION_WEBHOOK_URL=your_webhook_url_here
