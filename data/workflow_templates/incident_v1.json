{
  "workflow_id": "tpl-incident-v1",
  "version": 1,
  "name": "Quy trình xử lý Sự cố / Lỗi phần mềm v1",
  "description": "Phân loại sự cố, phân tích AI, tạo GitHub Issue và xác minh đối chiếu ngược.",
  "domain_pack": "enterprise_core",
  "request_type": "INCIDENT",
  "input_schema": ["request_id", "title", "sanitized_description", "request_type", "priority"],
  "output_schema": ["verification_outcome", "evidence_refs"],
  "limits": {
    "max_nodes": 20,
    "max_duration_seconds": 86400,
    "max_retries": 3,
    "max_parallelism": 4,
    "max_estimated_cost_usd": 2.0,
    "max_replans": 2
  },
  "nodes": [
    {
      "id": "n1_trigger",
      "type": "TRIGGER",
      "name": "Tiếp nhận yêu cầu sự cố",
      "config": {"source": "api"}
    },
    {
      "id": "n2_classify",
      "type": "CLASSIFY",
      "name": "Chuẩn hóa phân loại sự cố",
      "config": {"request_type": "INCIDENT", "require_completeness_check": true},
      "input_mapping": {"title": "trigger.title", "description": "trigger.sanitized_description"}
    },
    {
      "id": "n3_analysis",
      "type": "AI_ANALYSIS",
      "name": "Phân tích nguyên nhân và rủi ro",
      "config": {"roles": ["technical_analyst", "security_risk_analyst"], "max_rounds": 1},
      "input_mapping": {"dept": "n2_classify.department_code"}
    },
    {
      "id": "n4_github_issue",
      "type": "CONNECTOR_ACTION",
      "name": "Tạo GitHub Issue cho đội Kỹ thuật",
      "config": {
        "connector": "mock_github",
        "action": "create_issue",
        "target_repository": "Duckyeeen/VADIRAS-FLOW",
        "parameters": {"labels": ["incident", "triage"]}
      },
      "input_mapping": {"risk": "n3_analysis.risk_level"},
      "required_capabilities": ["mock_github:create_issue"],
      "resource_scope": "github:repo:Duckyeeen/VADIRAS-FLOW",
      "risk_class": "LOW"
    },
    {
      "id": "n5_wait_update",
      "type": "WAIT_EVENT",
      "name": "Chờ cập nhật xử lý từ GitHub",
      "config": {"event_source": "github", "event_type": "issues", "timeout_hours": 48},
      "input_mapping": {"issue_id": "n4_github_issue.external_id"}
    },
    {
      "id": "n6_verify",
      "type": "VERIFICATION",
      "name": "Đọc ngược và đối chiếu bằng chứng sự cố",
      "config": {
        "evaluator_type": "DETERMINISTIC_FIRST",
        "require_read_back": true,
        "postconditions": ["issue_exists_in_allowlisted_repo", "linked_evidence_present"],
        "evidence_sources": ["github_issue_readback"],
        "freshness_seconds": 300
      },
      "input_mapping": {"external_id": "n4_github_issue.external_id"}
    },
    {
      "id": "n7_end",
      "type": "END",
      "name": "Hoàn tất quy trình sự cố",
      "config": {"expected_outcome": "VERIFIED"},
      "input_mapping": {"outcome": "n6_verify.verification_outcome"}
    }
  ],
  "edges": [
    {"id": "e1", "source": "n1_trigger", "target": "n2_classify"},
    {"id": "e2", "source": "n2_classify", "target": "n3_analysis"},
    {"id": "e3", "source": "n3_analysis", "target": "n4_github_issue"},
    {"id": "e4", "source": "n4_github_issue", "target": "n5_wait_update"},
    {"id": "e5", "source": "n5_wait_update", "target": "n6_verify"},
    {"id": "e6", "source": "n6_verify", "target": "n7_end"}
  ]
}
